<div class="experience-page"><main class="container"><div class="intro"><div class="intro-label">ENGINEERING EXPERIENCE</div><h1>실무경험</h1><p>네트워크 장비의 통신, 제어, 장애 대응을 구현한 경험입니다.</p></div><div id="projects" class="projects" role="tablist" aria-label="프로젝트"></div><section id="overview" class="overview" aria-label="프로젝트 개요"></section><section class="work"><aside class="side"><h3>주요 개발 업무</h3><div id="topics" class="topics" role="tablist" aria-label="개발 업무"></div></aside><article id="content" class="content" aria-live="polite"></article></section><details id="gallerywrap" class="gallerywrap"><summary>프로젝트 전체 기술 자료 <span id="count" class="count"></span></summary><div id="gallery" class="gallery"></div></details></main><footer class="sitefoot">본 포트폴리오는 실무 개발 경험과 담당 업무를 중심으로 작성하였으며, 소속 기업의 기술정보 보호를 위해 일부 제품명과 세부 구현 내용을 익명화하거나 개념화하였습니다.</footer><dialog id="modal" class="modal" aria-labelledby="modalTitle"><div class="fighead"><h4 id="modalTitle"></h4><div class="modaltools"><button id="saveSvg" class="plainbtn" hidden>SVG 저장</button><button id="closeModal" class="plainbtn close" aria-label="닫기">×</button></div></div><div id="modalStage" class="stage"></div><p id="scopeNote" class="scope-note" hidden></p></dialog>
<script id="experience-payload" type="application/json">{"projects":[{"id":"cluster","name":"Cluster Sync","category":"Linux System SW","subtitle":"바이패스 장비 간 상태 공유 및 장애 대응 시스템","desc":"두 대의 바이패스 장비가 서로의 동작 상태를 공유하고, 장애 상황에서 운영 정책에 따라 연동하도록 개발했습니다.","role":"장비 간 통신, 상태 관리 및 복구, 암호화, 운영 인터페이스 개발","topics":[{"name":"개발 목적","lead":"개별 장비 제어를 장비 간 연동으로 확장","body":["보안장비 장애에 대응하기 위해 상대 바이패스 장비의 상태를 공유하고 운영 모드와 통신 상태를 종합하여 제어하도록 구현했습니다."],"diagrams":["cluster-purpose"]},{"name":"시스템 구성 및 담당 범위","lead":"통신부터 최종 장비 동작, 운영 화면까지 연결","body":["C와 임베디드 Linux 환경에서 통신 및 이벤트 처리, 상태 판단, 제어 연동, CLI와 웹 GUI, Syslog 기능을 개발했습니다."],"diagrams":["cluster-arch","cluster-01"]},{"name":"통신 및 이벤트 처리","lead":"UDP 논블로킹 통신과 이벤트 통지 구현","body":["UDP 소켓은 논블로킹 방식으로 구성하고 epoll을 통해 이벤트를 감시했습니다. eventfd로 설정 변경 관련 이벤트를 통지하고, 마지막 수신 시각과 Heartbeat를 통해 연결 상태를 관리했습니다."],"diagrams":["cluster-seq","cluster-01"]},{"name":"상태 관리 구조 개선","lead":"설정값과 실제 적용 상태의 분리","body":["장애 대응으로 강제된 상태가 기존 설정을 덮어쓰거나 잘못 전파되는 문제를 개선하기 위해 로컬 설정, Peer 수신 정보, 실제 적용 상태를 분리했습니다. 복구 조건에 따른 기존 상태 복원 로직도 정비했습니다."],"diagrams":["cluster-state","cluster-02"]},{"name":"장애 대응 및 복구","lead":"운영 모드와 Fail-Action에 따른 제어","body":["자동 및 반자동 모드에서 상대 상태를 반영하고 수동 모드에서는 운영자의 설정을 우선했습니다. Timeout에 따라 설정된 장애 대응 동작을 적용하고 재부팅, 동기화 해제 등의 예외를 처리했습니다."],"diagrams":["cluster-03","cluster-02"]},{"name":"통신 보안 및 기술 선정","lead":"AES-128-GCM으로 메시지 인증 및 암호화","body":["DTLS와 AES-GCM을 구현·비교하고 배포 일정과 유지보수성을 고려해 선임과 리뷰 후 UDP에 AES-GCM을 적용했습니다. 인증 성공 데이터만 장비 상태와 수신 시각 갱신에 사용했습니다."],"diagrams":["cluster-packet","cluster-04","cluster-choice"]},{"name":"운영 지원 및 문서화","lead":"연결 상태와 실제 제어 결과를 구분하여 표시","body":["CLI와 웹 GUI에 상태 및 동작 결과를 표시하고 Syslog에 변화 이력을 기록했습니다. 설정 방법과 장애 유형별 운영 절차를 문서화했습니다."],"diagrams":["cluster-05"]}],"tech":[{"name":"C","why":"시스템 기능 구현","how":"상태 구조체, 소켓 및 메시지 처리, 설정과 장애 대응 로직 작성.","topic":1},{"name":"Linux","why":"이벤트 기반 장비 간 통신","how":"임베디드 Linux에서 파일 디스크립터와 이벤트 처리 기능 활용.","topic":2},{"name":"UDP","why":"상태 메시지 교환","how":"논블로킹 소켓으로 주기 메시지와 상태 변경 메시지 송수신.","topic":2},{"name":"epoll","why":"수신 및 이벤트 감시","how":"등록한 파일 디스크립터의 준비 이벤트를 감시하여 처리.","topic":2},{"name":"eventfd","why":"설정 변경 이벤트 통지","how":"설정 변경에 따른 이벤트 통지를 수신 감시 구조와 연동.","topic":2},{"name":"AES-GCM","why":"메시지 인증 및 암호화","how":"OpenSSL 기반 AES-128-GCM 적용, Header AAD와 Tag 검증 활용.","topic":5},{"name":"CLI / CGI","why":"장비 운영 지원","how":"설정, 연결 상태 및 제어 결과 조회 기능 개발.","topic":6},{"name":"Syslog","why":"상태 변화 진단","how":"연결 장애 및 장비 동작 변화 기록.","topic":6}]},{"id":"utp","name":"STM32 UTP TAP","category":"MCU Firmware","subtitle":"4포트 UTP TAP 펌웨어 및 하드웨어 제어","desc":"새로운 MCU 환경에서 개발 도구를 설정하고 PHY 제어, 통신 모드, LLCF 장애 전파 및 복구 기능을 구현했습니다.","role":"개발 환경 구축, 펌웨어, 레지스터 제어, 상태 머신, 디버그 CLI 및 보드 검증","topics":[{"name":"하드웨어 구성 및 담당 범위","lead":"MCU에서 PHY와 주변장치 제어","body":["프로세서 구조와 회로도, 데이터시트 및 기존 코드를 분석하여 STM32F217 기반 보드의 하드웨어 제어 관계를 파악했습니다. PHY 4개와 다이얼, 릴레이, LED 관련 제어 펌웨어를 개발했습니다."],"diagrams":["utp-hw"]},{"name":"개발 환경 및 초기화","lead":"핀맵 설정부터 JTAG 업로드까지","body":["STM32CubeMX로 핀과 주변장치 설정을 구성하고 CubeIDE에서 C 펌웨어를 개발했습니다. JTAG으로 펌웨어를 업로드하고 초기화 로그를 확인했습니다."],"diagrams":["utp-01"]},{"name":"PHY 및 통신 모드","lead":"다이얼 설정에 따라 속도와 자동협상 구성","body":["HAL과 MDIO를 활용하여 각 PHY의 레지스터에 접근했습니다. 다이얼 입력을 기반으로 10M, 100M, 1G 및 자동협상 조건을 적용하고 링크 속도와 상태를 조회했습니다."],"diagrams":["utp-02","utp-hw"]},{"name":"LLCF 개발 목적","lead":"한쪽 링크 장애를 반대편에 전달","body":["링크 장애를 반대편 네트워크가 인지할 수 있도록 PHY 제어를 연동하는 LLCF 기능을 구현했습니다."],"diagrams":["utp-llcf-purpose"]},{"name":"LLCF 상태 머신","lead":"5개 상태로 장애 감지와 복구 제어","body":["INIT, OK, POLL_A, POLL_B, CHECK 상태를 정의하고 각 전환 조건에 따라 PHY 활성화 여부를 제어했습니다. 링크 복구 조건을 확인하여 정상 감시 흐름으로 돌아가도록 구성했습니다."],"diagrams":["utp-03"]},{"name":"디버그 CLI","lead":"반복 빌드 없이 하드웨어 점검","body":["USART 콘솔에서 PHY 주소와 레지스터 페이지를 지정해 값을 읽고 쓰며 릴레이도 제어할 수 있도록 구현했습니다. 입력값 및 HAL 반환값을 확인해 잘못된 요청과 접근 오류를 구분했습니다."],"diagrams":["utp-debug-before","utp-04","utp-console"]},{"name":"실제 보드 검증","lead":"모드와 링크 조건을 변경하며 동작 확인","body":["실제 보드와 PC를 연결해 모드별 링크 속도, Duplex, LED 표시를 확인했습니다. LLCF의 장애 전파 및 복구도 검증했으며 개발 환경과 실험 결과를 문서화했습니다."],"diagrams":["utp-matrix","utp-05"]}],"tech":[{"name":"C","why":"MCU 펌웨어 구현","how":"초기화, 주기적 상태 조회, 상태 전이 및 CLI 로직 작성.","topic":0},{"name":"STM32 / HAL","why":"MCU 주변장치 제어","how":"핀맵과 주변장치 초기화, HAL API 기반 하드웨어 접근.","topic":1},{"name":"MDIO / MDC","why":"개별 PHY 설정 및 상태 확인","how":"PHY 주소와 레지스터 페이지를 구분해 읽기 및 쓰기.","topic":2},{"name":"GPIO","why":"물리 입력 및 출력 제어","how":"다이얼 입력과 릴레이 및 LED 제어에 활용.","topic":0},{"name":"FSM","why":"장애 감시 및 복구","how":"LLCF를 다섯 가지 상태와 전환 조건으로 구성.","topic":4},{"name":"USART","why":"하드웨어 점검 콘솔","how":"레지스터 조회·수정 및 릴레이 제어 명령 구현.","topic":5},{"name":"JTAG","why":"펌웨어 업로드","how":"실제 보드에 펌웨어를 올리고 개발 환경 구성.","topic":1}]},{"id":"ot24","name":"MIDAS OT24","category":"ASIC & System SW","subtitle":"TAP 장비 포팅 및 패킷 처리 시스템 개발","desc":"기존 제품의 SW를 신규 보드에 맞게 변경하고, 포트 포워딩 및 패킷 복제 기능과 ASIC 자원 관리 구조를 개발했습니다.","role":"모델 포팅, CLI·드라이버 연동, ASIC 규칙 관리, 트래픽 분석 및 빌드 구성","topics":[{"name":"제품 활용 목적","lead":"수집 트래픽을 모니터링 대상으로 전달","body":["입력 포트에서 수집한 네트워크 패킷을 지정된 출력 포트 그룹으로 전달할 수 있도록 포워딩 기능을 개발했습니다."],"diagrams":["ot24-purpose","ot24-replication"]},{"name":"SW 계층 및 개발 범위","lead":"설정 경로와 패킷 전달 경로 구분","body":["CLI 설정을 내부 규칙 관리 및 드라이버와 연결하고, CPSS SDK를 활용해 실제 ASIC의 패킷 처리 규칙을 구성했습니다."],"diagrams":["ot24-plane","ot24-01"]},{"name":"ASIC 자원 관리 개선","lead":"TCAM 초기 구성과 VIDX 갱신 분리","body":["포워딩 규칙 추가 시 TCAM을 생성하던 구조를 부팅 시 PCL과 TCAM을 구성하고 설정 변경 시 VIDX를 갱신하는 방식으로 변경했습니다. 소스 포트와 규칙 인덱스의 대응 관계를 정리했습니다."],"diagrams":["ot24-02"]},{"name":"패킷 포워딩 및 복제","lead":"출력 포트 그룹에 트래픽 전달","body":["PCL 및 TCAM으로 패킷 처리 규칙을 구성하고 VIDX로 출력 대상 포트 그룹을 관리했습니다. CLI를 통해 설정하고 재부팅 이후 설정이 유지되도록 저장 기능을 구현했습니다."],"diagrams":["ot24-replication","ot24-03","ot24-01"]},{"name":"트래픽 손실 분석","lead":"실제 손실과 카운터 집계 차이 구분","body":["입출력 트래픽 차이의 원인을 분석하기 위해 Egress Drop용 CNC 카운터 추가 작업, 카운터 매핑 및 버퍼 자원 검토를 수행했습니다. 확인되지 않은 개선율이나 검증 완료를 주장하지 않습니다."],"diagrams":["ot24-04"]},{"name":"제품 포팅 및 빌드","lead":"기존 모델에서 신규 보드 구성으로 변경","body":["기존 POE 장비 SW의 포트, 슬롯, MPP 설정을 수정하고 불필요한 서비스와 명령을 정리했습니다. 제품별 Makefile 대상과 부트로더 이미지 구성을 변경했습니다."],"diagrams":["ot24-porting","ot24-06"]},{"name":"운영 및 사용률 조회","lead":"포트 사용률 조회 기능 구현 및 검증","body":["운영자가 CLI에서 포트별 트래픽 사용률을 조회할 수 있도록 기능을 구현하고 검증했습니다. 관리 포트 식별 및 세션 관련 처리도 정비했습니다."],"diagrams":["ot24-05"]}],"tech":[{"name":"C / Linux","why":"장비 시스템 SW 개발","how":"설정 관리, CLI 및 드라이버 연동과 제품별 구성.","topic":1},{"name":"Marvell CPSS","why":"스위칭 ASIC 설정","how":"SDK API를 사용해 하드웨어 규칙과 출력 그룹 관리.","topic":1},{"name":"PCL / TCAM","why":"패킷 처리 규칙 구성","how":"부팅 시 규칙을 구성하도록 초기화 구조 변경.","topic":2},{"name":"VIDX","why":"출력 포트 그룹 관리","how":"포워딩 대상 변경 시 출력 그룹 설정 갱신.","topic":2},{"name":"CNC","why":"패킷 드롭 분석","how":"Egress Drop 카운터 추가 및 통계 집계 관계 검토.","topic":4},{"name":"CLI","why":"운영자 설정 및 조회","how":"포워딩 설정, 저장 및 사용률 조회 기능 개발.","topic":6},{"name":"Makefile","why":"제품별 빌드 구성","how":"신규 빌드 대상과 제품 이미지 생성 구성 대응.","topic":5}]}],"diagrams":{"cluster-01":{"id":"cluster-01","title":"장비 간 통신 구성도","description":"UDP 논블로킹 소켓을 통해 장비 상태를 교환하고, epoll로 수신 및 이벤트를 감시한다.","note":"통신 구성 개념도. 송수신 루프의 세부 실행 순서 및 이벤트 등록 방식은 원본 소스 확인 필요.","group":"cluster","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"cluster-02":{"id":"cluster-02","title":"모드별 동작 판단도","description":"운영자의 설정, 상대 장비의 상태, 실제 적용 상태를 분리하고 제어 우선순위를 반영한다.","note":"정상 연결에서의 모드별 판단 개념도. Manual-Bypass 상태는 자동 모드 Peer에 영향을 줄 수 있음.","group":"cluster","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"cluster-03":{"id":"cluster-03","title":"장애 및 복구 흐름도","description":"주기적인 연결 감시와 Fail-Action을 통해 통신 단절 및 복구 상황을 처리한다.","note":"기능 개념도. 통신 재개와 Sync-Off는 동일한 상태 전이로 단정하지 않으며, 정확한 원복 조건은 최종 코드 확인 필요.","group":"cluster","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"cluster-04":{"id":"cluster-04","title":"AES-GCM 송수신 흐름도","description":"AES-128-GCM으로 상태 메시지를 보호하고 인증에 성공한 데이터만 시스템에 반영한다.","note":"사용자 제공 구현 내역 기반. 재전송 공격 차단, 키 교환·관리 방식 및 보안 검증 성과는 주장하지 않음.","group":"cluster","type":"svg","src":"data:image/svg+xml;base64,","displayNote":"재전송 공격 차단 및 키 관리 방식은 표현하지 않았습니다."},"cluster-05":{"id":"cluster-05","title":"운영 정보 전달도","description":"연결 상태와 실제 제어 결과를 분리하여 운영자가 장애 원인과 현재 상태를 확인하도록 지원한다.","note":"논리적 정보 전달 구조. CLI/CGI/서버 함수의 세부 호출 관계는 생략.","group":"cluster","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"utp-01":{"id":"utp-01","title":"보드 초기화 흐름도","description":"MCU 및 주변장치를 초기화하고 PHY 설정이 끝난 후 릴레이를 제어한다.","note":"제공된 main.c 초기화 순서 기반. PHY ID 점검은 로그 출력이며 성공을 강제하는 검증 게이트는 아님.","group":"utp","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"utp-02":{"id":"utp-02","title":"통신 모드 설정도","description":"다이얼 입력을 읽어 자동협상 또는 강제 속도 모드를 선택하고 각 PHY 설정에 반영한다.","note":"제공된 코드 기준 모드 1·4는 1G 자동협상으로 처리된다. 1G 강제 모드 지원으로 표시하지 않음.","group":"utp","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"utp-03":{"id":"utp-03","title":"LLCF 상태 전이도","description":"한쪽 링크의 장애를 반대편에 전달하고, 복구를 감시하는 5개 상태를 구성한다.","note":"main.c 상태 전이 그대로 표현. 조건 미충족 시 현재 상태 유지(자기 루프 생략). 70회는 반복 횟수이며 고정된 복구 시간 보장은 아님.","group":"utp","type":"svg","src":"data:image/svg+xml;base64,","displayNote":"70회는 반복 횟수이며 고정된 복구 시간을 의미하지 않습니다. 상태 유지 전이는 생략했습니다."},"utp-04":{"id":"utp-04","title":"디버그 CLI 흐름도","description":"펌웨어를 다시 빌드하지 않고 콘솔에서 PHY 레지스터와 릴레이를 점검한다.","note":"제공된 main.c와 debug CLI 코드 기반. 입력 루프의 세부 키 처리 생략.","group":"utp","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"utp-05":{"id":"utp-05","title":"실제 보드 검증 흐름도","description":"모드와 링크 조건을 바꾸면서 보드 동작 및 PC 네트워크 상태를 확인한다.","note":"실험 PPT와 사용자 설명 기반의 검증 절차 개념도. LLCF 검증 완료는 사용자 확인 사항이며 정량 성능 수치는 미제시.","group":"utp","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"ot24-01":{"id":"ot24-01","title":"포워딩 설정 흐름도","description":"CLI 설정을 소스 포트 기준으로 관리하고 드라이버의 ASIC 설정과 연결한다.","note":"커밋 및 작업 요약 기반 개념도. 실제 CLI·드라이버 호출 함수 순서 미확인.","group":"ot24","type":"svg","src":"data:image/svg+xml;base64,","displayNote":""},"ot24-02":{"id":"ot24-02","title":"규칙 관리 개선 전후도","description":"규칙 추가 때 TCAM을 생성하던 방식에서 부팅 시 초기화하고 VIDX를 갱신하는 구조로 개선했다.","note":"제공된 OT24 개발 내역 기반. 처리 시간 및 자원 사용량 개선 수치 없음.","group":"ot24","type":"svg","src":"data:i